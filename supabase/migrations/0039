alter table public.transactions
  add column if not exists to_account_id uuid references public.payment_accounts(id) on delete set null,
  add column if not exists to_amount numeric,
  add column if not exists to_currency text,
  add column if not exists commission numeric not null default 0,
  add column if not exists commission_currency text,
  add column if not exists debit_amount numeric,
  add column if not exists debit_currency text;

alter table public.transactions drop constraint if exists transactions_category_check;
alter table public.transactions add constraint transactions_category_check
  check (category in ('client_payment','hotel_commission','supplier_payment','other','exchange'));
  